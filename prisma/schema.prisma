// CraftConnect — Prisma Schema mapped to actual Django ORM tables
// All fields precisely match the real Django model column names

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ── accounts_customuser ───────────────────────────────────────────────────────
// Django: accounts.CustomUser (extends AbstractUser)
model User {
  id            Int       @id @default(autoincrement())
  password      String
  last_login    DateTime?
  is_superuser  Boolean   @default(false)
  username      String    @unique
  first_name    String    @default("")
  last_name     String    @default("")
  email         String    @unique
  is_staff      Boolean   @default(false)
  is_active     Boolean   @default(true)
  date_joined   DateTime  @default(now())
  // Custom fields on CustomUser
  role          String    @default("consumer")
  phone         String    @default("")
  bio           String    @default("")
  profile_image String?
  is_verified   Boolean   @default(false)
  created_at    DateTime  @default(now())
  updated_at    DateTime  @updatedAt

  products  Product[]
  courses   Course[]
  orders    Order[]   @relation("OrderConsumer")
  payments  Payment[]

  @@map("accounts_customuser")
}

// ── products_product ──────────────────────────────────────────────────────────
// Django: products.Product
model Product {
  id           Int       @id @default(autoincrement())
  artisan_id   Int
  artisan      User      @relation(fields: [artisan_id], references: [id], onDelete: Cascade)
  title        String
  description  String
  price        Decimal   @db.Decimal(10, 2)
  image        String?
  category     String    @default("other")
  stock        Int       @default(0)
  is_published Boolean   @default(false)
  is_active    Boolean   @default(true)
  created_at   DateTime  @default(now())
  updated_at   DateTime  @updatedAt

  orderItems   OrderItem[]

  @@map("products_product")
}

// ── courses_course ────────────────────────────────────────────────────────────
// Django: courses.Course
model Course {
  id            Int      @id @default(autoincrement())
  artisan_id    Int
  artisan       User     @relation(fields: [artisan_id], references: [id], onDelete: Cascade)
  title         String
  description   String
  monthly_price Decimal  @db.Decimal(10, 2)
  thumbnail     String?
  category      String   @default("")
  is_published  Boolean  @default(false)
  created_at    DateTime @default(now())
  updated_at    DateTime @updatedAt

  videos        Video[]

  @@map("courses_course")
}

// ── courses_video ─────────────────────────────────────────────────────────────
// Django: courses.Video
model Video {
  id               Int      @id @default(autoincrement())
  course_id        Int
  course           Course   @relation(fields: [course_id], references: [id], onDelete: Cascade)
  title            String
  description      String   @default("")
  video_url        String
  order            Int      @default(0)
  duration_minutes Int      @default(0)
  created_at       DateTime @default(now())

  @@map("courses_video")
}

// ── orders_order ──────────────────────────────────────────────────────────────
// Django: orders.Order
model Order {
  id               Int       @id @default(autoincrement())
  consumer_id      Int
  consumer         User      @relation("OrderConsumer", fields: [consumer_id], references: [id], onDelete: Cascade)
  status           String    @default("pending")
  total_amount     Decimal   @db.Decimal(12, 2) @default(0)
  shipping_address String    @default("")
  notes            String    @default("")
  created_at       DateTime  @default(now())
  updated_at       DateTime  @updatedAt

  items    OrderItem[]
  payments Payment[]

  @@map("orders_order")
}

// ── orders_orderitem ──────────────────────────────────────────────────────────
// Django: orders.OrderItem
model OrderItem {
  id         Int     @id @default(autoincrement())
  order_id   Int
  order      Order   @relation(fields: [order_id], references: [id], onDelete: Cascade)
  product_id Int
  product    Product @relation(fields: [product_id], references: [id], onDelete: Restrict)
  quantity   Int     @default(1)
  price      Decimal @db.Decimal(10, 2)

  @@unique([order_id, product_id])
  @@map("orders_orderitem")
}

// ── payments_payment ──────────────────────────────────────────────────────────
// Django: payments.Payment
model Payment {
  id              Int      @id @default(autoincrement())
  user_id         Int
  user            User     @relation(fields: [user_id], references: [id], onDelete: Cascade)
  order_id        Int?
  order           Order?   @relation(fields: [order_id], references: [id], onDelete: SetNull)
  subscription_id Int?
  amount          Decimal  @db.Decimal(12, 2)
  method          String   @default("card")
  status          String   @default("pending")
  upi_id          String?
  transaction_id  String   @unique
  created_at      DateTime @default(now())

  @@map("payments_payment")
}
