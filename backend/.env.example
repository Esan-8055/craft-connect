# Craft Connect Backend Environment Variables
DJANGO_SECRET_KEY=your-secret-key-here
DJANGO_DEBUG=True

# ─── Aiven PostgreSQL Connection Setup ─────────────────────────────────────
DATABASE_URL=postgres://username:password@your-db-host:port/dbname?sslmode=require

# ─── Aiven Apache Kafka Configuration ──────────────────────────────────────
KAFKA_HOST=your-kafka-host.aivencloud.com
KAFKA_PORT=19400
KAFKA_REST_PORT=19391
KAFKA_USER=avnadmin
KAFKA_PASSWORD=your-kafka-password
KAFKA_SECURITY_PROTOCOL=SASL_SSL
KAFKA_SASL_MECHANISM=SCRAM-SHA-512

# ─── Razorpay Payment Gateway Credentials ───────────────────────────────────
RAZORPAY_KEY_ID=rzp_test_XXXXXXXXXXXXXXXXXXXX
RAZORPAY_KEY_SECRET=your-razorpay-secret-here
